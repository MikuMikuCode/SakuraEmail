# Create a real .env next to this file. Never commit it.
BOT_TOKEN=replace_with_telegram_bot_token
BOT_OWNER_ID=replace_with_numeric_telegram_id

# Existing Apps Script Web App URL ending in /exec.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Generate a long random value and add the same value to Apps Script
# Project Settings -> Script Properties -> BOT_API_SECRET.
BOT_API_SECRET=replace_with_at_least_32_random_characters

# This file is intentionally stored under ignored data/.
DATABASE_PATH=data/sakuraemail.sqlite3

# How often the bot asks Apps Script for renewal notifications.
# 3600 = once per hour. Minimum accepted value is 300 seconds.
NOTIFICATION_POLL_SECONDS=3600
